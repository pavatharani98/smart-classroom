<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Classrooms – Smart Classroom System</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
</head>
<body>
  <header class="main-header">
    <div class="header-content">
      <div class="header-icon"><i class="fas fa-chalkboard-teacher"></i></div>
      <div>
        <h1>Smart Classroom Information System</h1>
        <p>All registered classrooms</p>
      </div>
    </div>
    <a href="/" class="btn-view-all"><i class="fas fa-plus"></i> Add Classroom</a>
  </header>

  <div class="list-container">
    <div class="page-title">
      <i class="fas fa-list" style="font-size:1.6rem;color:#3949ab;"></i>
      <h1>Registered Classrooms (<%= classrooms.length %>)</h1>
    </div>

    <% if (classrooms.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-door-open"></i>
      <p>No classrooms registered yet. <a href="/" style="color:#3949ab;">Add your first classroom →</a></p>
    </div>
    <% } else { %>
    <div class="classroom-list">
      <% classrooms.forEach(c => { %>
      <div class="classroom-row">
        <div class="classroom-row-info">
          <h3><i class="fas fa-door-open" style="margin-right:8px;color:#5c6bc0;"></i><%= c.classroom_number %></h3>
          <p><i class="fas fa-university" style="margin-right:5px;"></i><%= c.school_name %> &nbsp;|&nbsp;
             <i class="fas fa-layer-group" style="margin-right:5px;"></i><%= c.grade_class %> &nbsp;|&nbsp;
             <i class="fas fa-users" style="margin-right:5px;"></i><%= c.total_students %> students</p>
        </div>
        <div class="classroom-row-actions">
          <a href="/classroom/<%= c.id %>" class="btn-sm view" target="_blank">
            <i class="fas fa-eye"></i> View
          </a>
          <a href="/success/<%= c.id %>" class="btn-sm qr">
            <i class="fas fa-qrcode"></i> QR Code
          </a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

  <footer class="main-footer">
    <p><i class="fas fa-qrcode"></i> Smart Classroom Information System &copy; 2026</p>
  </footer>
</body>
</html>
