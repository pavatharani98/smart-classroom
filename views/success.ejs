<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>QR Code Generated – <%= classroom.classroom_number %></title>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
</head>
<body>
  <header class="main-header">
    <div class="header-content">
      <div class="header-icon"><i class="fas fa-chalkboard-teacher"></i></div>
      <div>
        <h1>Smart Classroom Information System</h1>
        <p>QR Code generated successfully</p>
      </div>
    </div>
    <a href="/classrooms" class="btn-view-all"><i class="fas fa-list"></i> View All Classrooms</a>
  </header>

  <div class="success-container">

    <!-- Success banner -->
    <div class="success-banner">
      <div class="check-icon"><i class="fas fa-check"></i></div>
      <h1>Classroom Registered!</h1>
      <p><strong><%= classroom.classroom_number %></strong> – <%= classroom.school_name %></p>
    </div>

    <!-- QR Code card -->
    <div class="qr-card">
      <h2><i class="fas fa-qrcode"></i> Your Unique QR Code</h2>
      <div class="qr-code-wrapper">
        <img src="<%= qrCodeDataUrl %>" alt="QR Code for <%= classroom.classroom_number %>" id="qrImg"/>
      </div>
      <div class="qr-url"><i class="fas fa-link"></i> <%= classroomUrl %></div>
      <p style="margin-top:14px; color:#666; font-size:0.88rem;">
        Print this QR code and display it on the classroom wall. Scanning it will show all classroom details.
      </p>

      <div class="action-buttons">
        <button class="btn-download" onclick="downloadQR()">
          <i class="fas fa-download"></i> Download QR Code
        </button>
        <a href="/classroom/<%= classroom.id %>" class="btn-view" target="_blank">
          <i class="fas fa-eye"></i> Preview Info Page
        </a>
        <button class="btn-download" onclick="window.print()" style="background: linear-gradient(135deg, #37474f, #546e7a);">
          <i class="fas fa-print"></i> Print QR Code
        </button>
        <a href="/" class="btn-new">
          <i class="fas fa-plus"></i> Add New Classroom
        </a>
      </div>
    </div>

  </div>

  <footer class="main-footer">
    <p><i class="fas fa-qrcode"></i> Smart Classroom Information System &copy; 2026</p>
  </footer>

  <script>
    function downloadQR() {
      const a = document.createElement('a');
      a.href = document.getElementById('qrImg').src;
      a.download = 'QR_<%= classroom.classroom_number.replace(/\s+/g,"_") %>.png';
      a.click();
    }
  </script>
</body>
</html>
